<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon, front layer: a golden oil drop, with the oil level inside it as the "mark".
    Everything stays inside the middle 66dp, which is the part every launcher shape shows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The drop: pointed top, round bottom. -->
    <path android:pathData="M54,24C54,24 35,45.5 35,60A19,19 0 0 0 73,60C73,45.5 54,24 54,24Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="79"
                android:startColor="#FFFFD77A"
                android:endColor="#FFF5B62E" />
        </aapt:attr>
    </path>

    <!-- The oil level: the lower part of the drop in a deeper amber, with a wavy surface. -->
    <group>
        <clip-path android:pathData="M54,24C54,24 35,45.5 35,60A19,19 0 0 0 73,60C73,45.5 54,24 54,24Z" />
        <path
            android:fillColor="#FFC27C0E"
            android:pathData="M30,61C38,56.5 46,65.5 54,61C62,56.5 70,65.5 78,61L78,90L30,90Z" />
    </group>

    <!-- A soft highlight down the left side, so the drop looks rounded. -->
    <path
        android:pathData="M43.5,55C44.5,49 48,43 51,38.5"
        android:strokeColor="#CCFFF3D6"
        android:strokeLineCap="round"
        android:strokeWidth="3" />
</vector>
